#!/bin/sh
# Block binary media from ever entering history. .gitignore is advisory —
# `git add -f` walks straight past it; this does not.
set -e

blocked=$(git diff --cached --name-only --diff-filter=AM \
	| grep -iE '\.(mp4|mov|webm|m4v|avi|mkv)$' || true)

if [ -n "$blocked" ]; then
	echo "pre-commit: refusing to commit video files:" >&2
	echo "$blocked" | sed 's/^/  /' >&2
	echo >&2
	echo "Video belongs in a GitHub release asset or object storage, not in git." >&2
	echo "Bypass only with a deliberate --no-verify if you truly mean it." >&2
	exit 1
fi
